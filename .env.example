# Copy this file to .env.local (gitignored) and fill in the values yourself.
# Never paste secret values into the Claude Code chat — paste them here in your
# editor. The /setup flow verifies presence with a presence-check script and
# never sees the value.

# --- Stripe (sandbox) -------------------------------------------------------
# From https://dashboard.stripe.com/test/apikeys
# Either standard (sk_test_...) or restricted (rk_test_...) keys work.
# /setup recommends a restricted key with minimum scopes; see .claude/commands/setup.md.
STRIPE_SECRET_KEY=

# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# Optional kill switch — set to "true" to return 503 on /api/checkout + webhook
# without removing the Stripe key. Stripe holds and retries events (~3-day window).
# STRIPE_DISABLED=true

# --- Cal.com ----------------------------------------------------------------
# From https://app.cal.com/settings/developer/api-keys
CALCOM_API_KEY=
CALCOM_USERNAME=

# --- Resend -----------------------------------------------------------------
# From https://resend.com/api-keys
RESEND_API_KEY=
# onboarding@resend.dev works for testing. For production, verify a domain at
# https://resend.com/domains and use an address on that domain.
EMAIL_FROM="Coaching Store <onboarding@resend.dev>"

# --- Cloudflare Turnstile (optional) ----------------------------------------
# Only needed if SITE.subprocessors.turnstile = true in src/config/site.ts.
# From https://dash.cloudflare.com → Turnstile → Add Site (managed mode).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- PostHog (optional) -----------------------------------------------------
# Only needed if SITE.subprocessors.posthog = true in src/config/site.ts.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
